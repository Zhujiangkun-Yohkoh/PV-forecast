  "nwp_forecast_leads_hours": [6, 9, 12, 15, 18, 21, 24],
  "nwp_lead_step_hours": 3,
  "nwp_alignment": {
    "DSWRF_surface": "piecewise interval-average over (startStep,endStep]",
    "TCDC_entire_atmosphere": "linear interpolation only when GRIB stepType=instant; otherwise interval support"
  },
  "download": {"workers": 48, "attempts": 3, "timeout_seconds": 90, "monthly_resume": true},
  "models": ["HISTORY_ONLY", "RAW_NWP", "AGE_LEAD_RELIABILITY"],
  "seeds": [42, 43, 44],
  "model": {
