{
  "seeds": [42, 43, 44],
  "datasets": {
    "Sanyo": "17Sanyo.csv",
    "Hanwha": "25Hanwha.csv",
    "Qcells": "38QCELLS.csv"
  },
  "data_root_candidates": [
    "../PVforecast16/GFNODE_experiments",
    "../PVforecast16"
  ],
  "timestamp_column": "timestamp",
  "target_column": "Active_Power",
  "original_feature_columns": [
    "Performance_Ratio",
    "Weather_Temperature_Celsius",
    "Weather_Relative_Humidity",
    "Global_Horizontal_Radiation",
    "Diffuse_Horizontal_Radiation",
    "Radiation_Global_Tilted",
    "Radiation_Diffuse_Tilted"
  ],
  "corrected_feature_columns": [
    "Performance_Ratio",
    "Weather_Temperature_Celsius",
    "Weather_Relative_Humidity",
    "Global_Horizontal_Radiation",
    "Diffuse_Horizontal_Radiation",
    "Radiation_Global_Tilted",
    "Radiation_Diffuse_Tilted",
    "Active_Power"
  ],
  "splits": {
    "train": ["2018-04-01 00:00:00", "2018-07-15 23:55:00"],
    "validation": ["2018-07-16 00:00:00", "2018-08-07 23:55:00"],
    "test": ["2018-08-08 00:00:00", "2018-08-31 23:55:00"]
  },
  "lookback": 72,
  "output_horizon": 144,
  "evaluation_horizons": [12, 48, 96, 144],
  "frequency_minutes": 5,
  "daylight_threshold_definition": "true target Active_Power > 0.01 * Train maximum Active_Power; evaluation only",
  "knn_neighbors": 5,
  "isolation_forest": {
    "enabled": true,
    "contamination": 0.01,
    "random_state": 42,
    "n_estimators": 100
  },
  "discrete_recurrent_decoder": {
    "embedding_dim": 64,
    "tcn_branch_channels": 24,
    "transformer_heads": 4,
    "transformer_layers": 1,
    "dropout": 0.1
  },
  "inverted_variate_transformer": {
    "d_model": 64,
    "heads": 4,
    "layers": 1
  },
  "joint_patch_transformer": {
    "d_model": 64,
    "heads": 4,
    "layers": 1,
    "patch_length": 12,
    "stride": 6
  },
  "depthwise_convolutional_tcn": {
    "channels": 64,
    "layers": 4,
    "kernel_size": 5
  },
  "training": {
    "batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 0.00001,
    "max_epochs": 25,
    "patience": 5,
    "min_delta": 1e-8,
    "gradient_clip_norm": 1.0,
    "num_workers": 0,
    "optimizer": "AdamW",
    "checkpoint_metric": "validation_global_masked_mse"
  },
  "normalization": "Train-only MinMaxScaler; error normalized by Train target range",
  "device": "cuda_if_available"
}
